generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String
  role                 String   @default("USER")         // USER | ADMIN
  fullName             String?
  firstName            String?
  lastName             String?
  phone                String?
  country              String?
  currency             String?  @default("USD")
  referralCode         String?
  kycStatus            String   @default("PENDING")      // PENDING | VERIFIED | REJECTED
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  wallets              Wallet[]
  transactions         Transaction[]
  copyTrades           CopyTrade[]
  passwordResetTokens  PasswordResetToken[]
  deposits             Deposit[]
  withdrawals          Withdrawal[]
  kycDocuments         KycDocument[]
  withdrawalAddresses  UserWithdrawalAddress[]
  subscriptions        Subscription[]
  signalPurchases      SignalPurchase[]
  realEstateInvestments RealEstateInvestment[]
  stakes               Stake[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  coin      String   // e.g. "BTC", "ETH", "USDT"
  balance   Decimal  @default(0.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, coin])
}

// Legacy Transaction model — kept for existing trade/copy-trade history
model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "DEPOSIT" | "WITHDRAWAL" | "TRADE"
  asset     String
  amount    Decimal
  usdValue  Decimal?
  status    String   // "PENDING" | "COMPLETED" | "FAILED"
  txHash    String?
  createdAt DateTime @default(now())
}

model CopyTrade {
  id        String   @id @default(uuid())
  userId    String
  traderId  String   // now a String UUID ref to CopyTrader
  amount    Float
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

// ─── Copy Trader Profiles (admin-managed) ─────────────────────────────────────

model CopyTrader {
  id         String   @id @default(uuid())
  name       String
  avatar     String   @default("🤖")   // emoji or URL
  roi        String                     // e.g. "+145.2%"
  winRate    String                     // e.g. "82%"
  aum        String                     // e.g. "$1.2M"
  followers  Int      @default(0)
  risk       String   @default("Medium") // Low | Medium | High
  handle     String?
  profitShare String?    @default("20%")
  wins       Int?       @default(0)
  losses     Int?       @default(0)
  trades     Int?       @default(0)
  minStartup String?    @default("$0")
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ─── Coin / Network catalogue ─────────────────────────────────────────────────

model CoinNetwork {
  id        String   @id @default(uuid())
  coin      String   // e.g. "USDT"
  network   String   // e.g. "TRC20"
  label     String   // Display label: "USDT (TRC20)"
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletAddresses AdminWalletAddress[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]

  @@unique([coin, network])
}

model AdminWalletAddress {
  id            String      @id @default(uuid())
  coinNetworkId String
  coinNetwork   CoinNetwork @relation(fields: [coinNetworkId], references: [id])
  address       String
  label         String?     // Optional admin note
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Deposits ────────────────────────────────────────────────────────────────

model Deposit {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  coinNetworkId     String
  coinNetwork       CoinNetwork @relation(fields: [coinNetworkId], references: [id])
  coin              String      // denormalised for query convenience
  network           String
  amount            Decimal
  txHash            String?     @unique
  proofUrl          String?     // local file path or URL
  walletAddressUsed String      // snapshot of admin address shown to user
  status            String      @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason   String?
  reviewedBy        String?     // Admin userId
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// ─── Withdrawals ─────────────────────────────────────────────────────────────

model Withdrawal {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  coinNetworkId   String
  coinNetwork     CoinNetwork @relation(fields: [coinNetworkId], references: [id])
  coin            String
  network         String
  amount          Decimal
  toAddress       String      // User's external withdrawal address
  status          String      @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ─── KYC ─────────────────────────────────────────────────────────────────────

model KycDocument {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  docType         String    // PASSPORT | DRIVERS_LICENSE | NATIONAL_ID | PROOF_OF_ADDRESS | SELFIE
  fileUrl         String    // local path or cloud URL
  fileName        String    // original file name for display
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── User withdrawal addresses ────────────────────────────────────────────────

model UserWithdrawalAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  coin      String
  network   String
  address   String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, coin, network])
}

// ─── Subscription Plans ───────────────────────────────────────────────────────

model SubscriptionPlan {
  id          String         @id @default(uuid())
  name        String         // e.g. "Starter plan"
  minAmount   Decimal
  maxAmount   Decimal
  durationDays Int
  roi         String         // e.g. "200%"
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  amount     Decimal
  currency   String           @default("USD")
  status     String           @default("ACTIVE")  // ACTIVE | COMPLETED | CANCELLED
  startDate  DateTime         @default(now())
  endDate    DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// ─── Signals ──────────────────────────────────────────────────────────────────

model SignalPackage {
  id          String          @id @default(uuid())
  name        String          // e.g. "CD V5"
  price       Decimal
  strength    Int             @default(10)  // percentage
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  purchases   SignalPurchase[]
}

model SignalPurchase {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  packageId String
  package   SignalPackage @relation(fields: [packageId], references: [id])
  amount    Decimal
  status    String        @default("ACTIVE")  // ACTIVE | EXPIRED
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ─── Real Estate ──────────────────────────────────────────────────────────────

model RealEstateProject {
  id          String              @id @default(uuid())
  name        String
  description String
  imageUrl    String?
  location    String?
  minAmount   Decimal
  roi         String              // e.g. "85%"
  strategy    String              // e.g. "Fixed Income"
  status      String              @default("OPEN")  // OPEN | CLOSED
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  investments RealEstateInvestment[]
}

model RealEstateInvestment {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  projectId String
  project   RealEstateProject @relation(fields: [projectId], references: [id])
  amount    Decimal
  status    String            @default("ACTIVE")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}


// """ Stake """

model Stake {
  id          String    @id @default(uuid())
  userId      String
  coin        String
  amount      Decimal
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
